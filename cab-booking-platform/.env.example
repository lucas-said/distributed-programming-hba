# Each service has its own .env file. This file documents the variables
# you'll need across the project. Copy the relevant ones into each
# services/<name>/.env when prompted in later steps.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority

# CloudAMQP connection string
RABBITMQ_URL=amqps://USER:PASS@HOST/VHOST

# RapidAPI key (used by Fare and Location services)
RAPIDAPI_KEY=replace_with_your_key

# JWT secret for Customer service auth
JWT_SECRET=replace_with_a_long_random_string

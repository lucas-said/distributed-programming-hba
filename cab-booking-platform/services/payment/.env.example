PORT=4003

# Mongo + AMQP
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DBNAME=cab_payment
RABBITMQ_URL=amqps://USER:PASS@HOST/VHOST

# JWT secret - same value as customer / booking / fare services.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Internal service URLs - the Payment service calls these synchronously
# during the /pay flow.
BOOKING_SERVICE_URL=http://localhost:4002
FARE_SERVICE_URL=http://localhost:4004

# Discount value applied AFTER the user has earned the loyalty discount
# (Task 5 - 3 successful bookings). 0.9 means a 10% discount.
DEFAULT_DISCOUNT_VALUE=0.9

PORT=4006

# Mongo - small DB just for the booking counters
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DBNAME=cab_events

# CloudAMQP - same broker as everyone else
RABBITMQ_URL=amqps://USER:PASS@HOST/VHOST

# Cab-ready delay (Task 6).
# Brief says 3 minutes. For local testing/demo you can lower this to a few
# seconds to see the flow without waiting.
CAB_READY_DELAY_MS=180000

# Discount value applied via discount.granted events. 0.9 = 10% off.
DISCOUNT_VALUE=0.9

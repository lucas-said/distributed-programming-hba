PORT=4002

# MongoDB - same Atlas cluster, separate logical database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DBNAME=cab_booking

# CloudAMQP - same broker as customer service
RABBITMQ_URL=amqps://USER:PASS@HOST/VHOST

# JWT secret - MUST be the same value as the customer service so this
# service can verify tokens that the customer service signed.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

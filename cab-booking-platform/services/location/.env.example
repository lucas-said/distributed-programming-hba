PORT=4005

# Mongo - same Atlas cluster, separate logical database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DBNAME=cab_location

# JWT secret - same value as the other services so we can verify tokens.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Weather API (RapidAPI) - WeatherAPI.com
# Subscribe at: https://rapidapi.com/weatherapi/api/weatherapi-com
# (You can reuse the same RAPIDAPI_KEY as the Fare service.)
WEATHER_API_URL=https://weatherapi-com.p.rapidapi.com
WEATHER_API_HOST=weatherapi-com.p.rapidapi.com
RAPIDAPI_KEY=replace_with_your_rapidapi_key

# This service has no broker connection - it's stateless on the event side.

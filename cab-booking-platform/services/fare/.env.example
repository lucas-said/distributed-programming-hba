PORT=4004

# JWT secret - same value as customer/booking services so we can verify tokens.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# Taxi Fare API (RapidAPI)
# Subscribe at: https://rapidapi.com/3b-data-3b-data-default/api/taxi-fare-calculator
TAXI_FARE_API_URL=https://taxi-fare-calculator.p.rapidapi.com
TAXI_FARE_API_HOST=taxi-fare-calculator.p.rapidapi.com
RAPIDAPI_KEY=replace_with_your_rapidapi_key

# This service has no database and does not connect to RabbitMQ - it's a
# stateless wrapper around the external API.

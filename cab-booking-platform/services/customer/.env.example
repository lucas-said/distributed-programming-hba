PORT=4001

# MongoDB - paste your Atlas connection string here
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DBNAME=cab_customer

# CloudAMQP - paste your AMQP URL here
RABBITMQ_URL=amqps://USER:PASS@HOST/VHOST

# JWT secret - any long random string. Use the same value in EVERY service
# that needs to verify tokens (booking, payment, location).
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

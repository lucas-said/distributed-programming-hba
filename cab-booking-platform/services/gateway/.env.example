PORT=4000

# URLs of the downstream services. In local dev these are localhost; in
# production they'll be the Render URLs (e.g. https://cab-customer.onrender.com).
CUSTOMER_SERVICE_URL=http://localhost:4001
BOOKING_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4003
FARE_SERVICE_URL=http://localhost:4004
LOCATION_SERVICE_URL=http://localhost:4005

# CORS - which origins are allowed to call the gateway. Use "*" for dev,
# tighten in production to your deployed frontend URL.
CORS_ORIGIN=*
